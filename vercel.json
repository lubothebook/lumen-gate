{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && cd frontend && npm install && cd ../gate2/web && npm install && cd ../../stello/web && npm install",
  "buildCommand": "cd frontend && npm run build && cd ../gate2/web && npm run build -- --base=/gate2/ && mkdir -p ../../frontend/dist/gate2 && cp -r dist/. ../../frontend/dist/gate2/ && cd ../../stello/web && npm run build -- --base=/stello/ && mkdir -p ../../frontend/dist/stello && cp -r dist/. ../../frontend/dist/stello/",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/*.js": {
      "memory": 512,
      "maxDuration": 60,
      "includeFiles": "{deployments/**/*.json,anchor/stellar.toml}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|gate2/|stello/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
