# Local runtime state: the demo SEP-10 signing secret, and the SEP-6 record
# store the facade persists while it runs. Neither is product content.
/.runtime/
/deployments/sep6-transactions.json

# Local build and dependency artifacts
#
# /build holds the circuit build directory: the r1cs and the wasm witness
# generator for each circuit, the powers-of-tau files, the proving keys, and the
# intermediate proofs. They are regenerated by
#
#   circuits/build.sh <circuit>
#   PTAU_POWER=<n> circuits/setup.sh <circuit>
#
# and the parts a reviewer needs to check a live deployment without rerunning the
# setup -- the Soroban-form verification key, proof and public inputs -- are
# committed under circuits/.
/build/
/frontend/node_modules/
/frontend/dist/
/anchor/node_modules/
/target/

# Local environment and editor files
.env
.env.*
!.env.example
.DS_Store
.vscode/
.idea/

# Python bytecode from the circuit tooling
__pycache__/
*.pyc
/node_modules/

# SEP-6 transaction records written at runtime by the facade
deployments/sep6-transactions.json
/build/

# imported phase-1 transcripts are gigabyte-class binaries: never committed,
# they are re-fetched or re-supplied and re-verified; pins live in circuits/PTAU_SHA256
circuits/ptau/

# Gate 2.0 local install / build (1.0 frontend/ already ignored above)
/gate2/web/node_modules/
/gate2/web/dist/
/gate2/scripts/node_modules/
/gate2/soroban/gate_stamp/target/
/gate2/soroban/gate_stamp/.stellar/

/stello/web/node_modules/
/stello/web/dist/
